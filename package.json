{
  "name": "sys-photo",
  "version": "1.0.0",
  "description": "Photography app backend — Node.js / TypeScript / Express",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "ts-node src/db/migrations/migrate.ts",
    "worker": "ts-node src/jobs/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "bullmq": "^5.4.2",
    "cloudinary": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-jwt": "^8.5.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jwks-rsa": "^4.0.1",
    "multer": "^2.2.0",
    "pg": "^8.11.5",
    "zod": "^3.23.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "jest": "^30.5.1",
    "nodemon": "^3.1.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
