# ─────────────────────────────────────────────
# Copy this file to .env and fill in real values
# Never commit .env — it is in .gitignore
# ─────────────────────────────────────────────

# ── Server ───────────────────────────────────
# Port the Express server listens on
PORT=3000

# ── PostgreSQL (RDS in prod, Docker locally) ──
# Full connection string format: postgres://user:password@host:port/database
# Local Docker example: postgres://postgres:password@localhost:5432/sys_photo
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sys_photo

# ── Redis (ElastiCache in prod, Docker locally) ──
# Local Docker example: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── Auth0 ─────────────────────────────────────
# Domain from your Auth0 tenant dashboard (e.g. dev-abc123.us.auth0.com)
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Audience set in Auth0 API settings — used to validate JWTs
AUTH0_AUDIENCE=https://your-api-identifier

# Secret used to verify Auth0 webhook signatures (set in Auth0 > Hooks or Actions)
AUTH0_WEBHOOK_SECRET=your-webhook-secret

# ── Cloudinary ────────────────────────────────
# All three values are in your Cloudinary dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email ─────────────────────────────────────
# Which sender implementation to use: console | ses
# 'console' prints messages to stdout instead of sending — no credentials
# needed, which is what lets the expiry warning pipeline run locally.
EMAIL_PROVIDER=console

# From address on outbound mail. With EMAIL_PROVIDER=ses this must be an
# address or domain verified in SES, or every send is rejected.
EMAIL_FROM=no-reply@sysphoto.local

# ── Node environment ─────────────────────────
# Controls logging verbosity and error detail in responses
# Values: development | production | test
NODE_ENV=development
